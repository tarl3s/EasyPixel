<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:EasyPixel"
        xmlns:canvas="using:EasyPixel.Canvas"
        x:Class="EasyPixel.MainWindow"
        Title="EasyPixel" Width="1100" Height="700" MinWidth="560" MinHeight="380">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="{loc:T 'File'}">
        <MenuItem Header="{loc:T 'New…'}" InputGesture="Ctrl+N" Click="New_Click" />
        <MenuItem Header="{loc:T 'Open…'}" InputGesture="Ctrl+O" Click="Open_Click" />
        <MenuItem x:Name="RecentMenu" Header="{loc:T 'Open recent'}" />
        <Separator />
        <MenuItem Header="{loc:T 'Save'}" InputGesture="Ctrl+S" Click="Save_Click" />
        <MenuItem Header="{loc:T 'Save as…'}" InputGesture="Ctrl+Shift+S" Click="SaveAs_Click" />
        <MenuItem Header="{loc:T 'Export…'}" InputGesture="Ctrl+E" Click="Export_Click" />
        <Separator />
        <MenuItem Header="{loc:T 'Exit'}" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="{loc:T 'Edit'}">
        <MenuItem x:Name="UndoItem" Header="{loc:T 'Undo'}" InputGesture="Ctrl+Z" Click="Undo_Click" />
        <MenuItem x:Name="RedoItem" Header="{loc:T 'Redo'}" InputGesture="Ctrl+Y" Click="Redo_Click" />
        <Separator />
        <MenuItem Header="{loc:T 'Cut'}" InputGesture="Ctrl+X" Click="Cut_Click" />
        <MenuItem Header="{loc:T 'Copy'}" InputGesture="Ctrl+C" Click="Copy_Click" />
        <MenuItem Header="{loc:T 'Paste'}" InputGesture="Ctrl+V" Click="Paste_Click" />
        <MenuItem Header="{loc:T 'Delete'}" InputGesture="Delete" Click="Delete_Click" />
        <Separator />
        <MenuItem Header="{loc:T 'Select all'}" InputGesture="Ctrl+A" Click="SelectAll_Click" />
        <MenuItem Header="{loc:T 'Deselect'}" InputGesture="Ctrl+D" Click="Deselect_Click" />
      </MenuItem>
      <MenuItem Header="{loc:T 'View'}">
        <MenuItem Header="{loc:T 'Zoom in'}" InputGesture="Ctrl+OemPlus" Click="ZoomIn_Click" />
        <MenuItem Header="{loc:T 'Zoom out'}" InputGesture="Ctrl+OemMinus" Click="ZoomOut_Click" />
        <MenuItem Header="{loc:T 'Fit on screen'}" InputGesture="Ctrl+D0" Click="Fit_Click" />
        <Separator />
        <MenuItem x:Name="GridItem" Header="{loc:T 'Pixel grid'}" ToggleType="CheckBox" Click="Grid_Click" />
        <MenuItem x:Name="OnionItem" Header="{loc:T 'Onion skin'}" ToggleType="CheckBox" Click="Onion_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,1,0,1" Padding="8,4">
      <StackPanel x:Name="OptionsBar" Orientation="Horizontal" Spacing="10" Height="32" />
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Classes="dim" Margin="16,0,0,0" />
        <TextBlock x:Name="PosText" DockPanel.Dock="Right" Classes="dim" Margin="16,0,0,0" />
        <TextBlock x:Name="StatusText" Classes="dim" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Classes="bar" BorderThickness="0,0,1,0" Padding="4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,4">
          <Canvas Width="44" Height="44" HorizontalAlignment="Center">
            <Border x:Name="SecondarySwatch" Canvas.Left="16" Canvas.Top="16" Width="28" Height="28"
                    BorderBrush="{DynamicResource Text}" BorderThickness="1" />
            <Border x:Name="PrimarySwatch" Canvas.Left="0" Canvas.Top="0" Width="28" Height="28"
                    BorderBrush="{DynamicResource Text}" BorderThickness="1" />
          </Canvas>
          <Button x:Name="SwapButton" Content="⇄" Focusable="False" HorizontalAlignment="Center" Padding="8,0" Click="Swap_Click" />
          <TextBox x:Name="HexBox" Width="80" HorizontalAlignment="Center" FontSize="12" />
        </StackPanel>
        <WrapPanel x:Name="ToolStrip" Orientation="Horizontal" Width="80" />
      </DockPanel>
    </Border>

    <canvas:PixelCanvas x:Name="Canvas" />
  </DockPanel>
</Window>

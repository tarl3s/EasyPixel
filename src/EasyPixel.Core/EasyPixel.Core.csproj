<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable model, file formats and tools: no UI, no Windows-only code. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Learn pixel art: one markup file per lesson and language (Learn/Lessons/<lang>/NN-slug.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Learn\Lessons\**\*.md" LogicalName="Lessons/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
